{
  "name": "@freecodexyz/cli",
  "version": "0.5.10-alpha",
  "description": "",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/freecodexyz/fcf.git",
    "directory": "packages/cli"
  },
  "bin": {
    "fcf": "./dist/index.js"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "src/abi/FCFWrapper.json",
    "src/abi/RIK.json",
    "templates"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "abi": "forge build --root ../../contracts && node scripts/generate-abi.mjs",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "version:minor": "node scripts/bump-minor.mjs",
    "prepublishOnly": "pnpm version:minor && pnpm abi && pnpm test && pnpm typecheck && pnpm build",
    "postpublish": "node scripts/postpublish-github.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.24.0",
  "dependencies": {
    "@octokit/core": "^7.0.6",
    "@whetstone-research/doppler-sdk": "^1.0.23",
    "commander": "^15.0.0",
    "libsodium-wrappers": "^0.8.4",
    "viem": "^2.52.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
